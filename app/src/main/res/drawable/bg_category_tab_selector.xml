<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF713044" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#FFFFD98B" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF713044" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#FFFFD98B" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF6E2636" android:endColor="#FF391923" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#FFE0B86F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF202630" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#667D3441" />
        </shape>
    </item>
</selector>