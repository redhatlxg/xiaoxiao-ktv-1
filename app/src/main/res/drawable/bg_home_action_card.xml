<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF28232A" android:endColor="#FF171B23"/>
            <corners android:radius="9dp"/>
            <stroke android:width="1dp" android:color="#557D3441"/>
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start">
        <shape android:shape="rectangle">
            <solid android:color="#FFD94357"/>
            <corners android:topLeftRadius="9dp" android:bottomLeftRadius="9dp"/>
        </shape>
    </item>
</layer-list>